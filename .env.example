# Google OAuth client (Web application) for the console. Authorized redirect URI:
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generated by `make setup`
AUTH_SECRET=
APP_JWT_SECRET=
POSTGRES_PASSWORD=
RO_PASSWORD=
RW_PASSWORD=
APP_PASSWORD=

# Optional: static read_write key for CI / MCP Inspector (leave empty in production)
BOOTSTRAP_API_KEY=
# Optional: restrict console sign-in (comma-separated)
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
